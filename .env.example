# 이 파일을 복사해서 .env 를 만든다.
#   cp .env.example .env
# .env 는 .gitignore 대상이므로 커밋되지 않는다.
# 실제 비밀번호와 API Key 는 .env 에만 작성한다.

DB_URL=jdbc:postgresql://localhost:5432/grantfit
DB_USERNAME=grantfit
DB_PASSWORD=change-me

# 기업마당 지원사업정보 API 인증키
# 발급: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi
BIZINFO_API_KEY=

# Gemini API 키
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택. 기본값 gemini-3.8-flash
# GEMINI_MODEL=
